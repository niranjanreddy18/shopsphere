# Copy to `.env` at the project root. These variables are consumed by
# docker-compose.yml directly (Postgres credentials shared with the
# backend service, and build-time args for the frontend image).
# Per-service runtime configuration still lives in backend/.env and
# frontend/.env (copied from their own .env.example files) — this file
# only covers what docker-compose itself needs to wire the containers
# together.

DB_NAME=ecommerce_db
DB_USER=postgres
DB_PASSWORD=postgres

VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_key_here
