# Copy this file to `.env` for local development.

# Base URL of the Django REST API (no trailing slash).
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Stripe publishable (test mode) key — also returned by the create-intent
# API response, but set here too so Stripe.js can be loaded eagerly.
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_key_here
